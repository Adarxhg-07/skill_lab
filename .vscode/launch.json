{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Run Backend (Node.js)",
      "skipFiles": ["<node_internals>/**"],
      "program": "${workspaceFolder}/backend/server.js",
      "cwd": "${workspaceFolder}/backend",
      "restart": true,
      "console": "integratedTerminal"
    },
    {
      "type": "msedge",
      "request": "launch",
      "name": "Open Frontend in Edge",
      "file": "${workspaceFolder}/frontend/index.html"
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "Open Frontend in Chrome",
      "file": "${workspaceFolder}/frontend/index.html"
    }
  ]
}
