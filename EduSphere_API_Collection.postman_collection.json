{
  "info": {
    "_postman_id": "edusphere-collection-v2",
    "name": "EduSphere REST API Collection",
    "description": "Production API test suite for EduSphere. Covers all CRUD endpoints, cascading operations, query parameters, and automated assertions.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000/api",
      "type": "string"
    },
    {
      "key": "student_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "task_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. API Health Check (GET)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "http://localhost:3000/api"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('API running message returned', function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json.message).to.include('EduSphere API is running');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "2. Create Student (POST)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Aarav Sharma\",\n  \"email\": \"aarav.newman@edusphere.edu\",\n  \"rollNumber\": \"STU_NEWMAN_01\",\n  \"department\": \"Computer Science\",\n  \"year\": 3,\n  \"skills\": [\"JavaScript\", \"React\", \"Node.js\", \"MongoDB\"],\n  \"bio\": \"Full-stack developer profile tested via Newman/Postman.\"\n}"
        },
        "url": "http://localhost:3000/api/students"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 201 Created', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "var data = pm.response.json();",
              "pm.test('Student created with valid ID', function () {",
              "    pm.expect(data).to.have.property('_id');",
              "    pm.collectionVariables.set('student_id', data._id);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "3. List Students with Filter (GET)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "http://localhost:3000/api/students?department=Computer%20Science"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Students list is array', function () {",
              "    pm.expect(pm.response.json()).to.be.an('array');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "4. Get Single Student Profile (GET)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "http://localhost:3000/api/students/{{student_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Student name matches', function () {",
              "    pm.expect(pm.response.json().name).to.eql('Aarav Sharma');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "5. Update Student (PUT)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Aarav Sharma\",\n  \"year\": 4,\n  \"bio\": \"Senior developer specializing in cloud systems.\"\n}"
        },
        "url": "http://localhost:3000/api/students/{{student_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Year updated to 4', function () {",
              "    pm.expect(pm.response.json().year).to.eql(4);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "6. Create Task Linked to Student (POST)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Postman Newman Automated Task\",\n  \"description\": \"Verified end to end with Newman test runner.\",\n  \"dueDate\": \"2026-12-15T00:00:00.000Z\",\n  \"priority\": \"high\",\n  \"status\": \"todo\",\n  \"studentId\": \"{{student_id}}\"\n}"
        },
        "url": "http://localhost:3000/api/tasks"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 201 Created', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "var t = pm.response.json();",
              "pm.test('Task ID captured', function () {",
              "    pm.expect(t).to.have.property('_id');",
              "    pm.collectionVariables.set('task_id', t._id);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "7. List Tasks with Populated Student (GET)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "http://localhost:3000/api/tasks"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Tasks list is array', function () {",
              "    pm.expect(pm.response.json()).to.be.an('array');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "8. Update Task Status (PATCH)",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"done\"\n}"
        },
        "url": "http://localhost:3000/api/tasks/{{task_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Status is done', function () {",
              "    pm.expect(pm.response.json().status).to.eql('done');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "9. Cascade Delete Student & Tasks (DELETE)",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "http://localhost:3000/api/students/{{student_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Cascade message confirmed', function () {",
              "    pm.expect(pm.response.json().message).to.include('Student and associated tasks deleted');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    }
  ]
}
