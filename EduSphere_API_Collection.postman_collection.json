{
  "info": {
    "_postman_id": "edusphere-collection-v3",
    "name": "EduSphere REST API Collection (with Auth)",
    "description": "Production API suite for EduSphere including Authentication (JWT, bcrypt), Student Management, Task Kanban, and automated assertions.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000/api",
      "type": "string"
    },
    {
      "key": "auth_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "student_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "task_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "1.1 Invalid Login Test (401)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"mentor@edusphere.edu\",\n  \"password\": \"invalid_pass\"\n}"
            },
            "url": "http://localhost:3000/api/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 401 Unauthorized', function () {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "pm.test('Returns invalid email or password message', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.error).to.eql('Invalid email or password');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "1.2 Mentor Login (200 OK)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"mentor@edusphere.edu\",\n  \"password\": \"password123\"\n}"
            },
            "url": "http://localhost:3000/api/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var data = pm.response.json();",
                  "pm.test('Returns JWT token and mentor role', function () {",
                  "    pm.expect(data).to.have.property('token');",
                  "    pm.expect(data.user.role).to.eql('mentor');",
                  "    pm.collectionVariables.set('auth_token', data.token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "1.3 Student Login (200 OK)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"aarav.sharma@edusphere.edu\",\n  \"password\": \"password123\"\n}"
            },
            "url": "http://localhost:3000/api/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var data = pm.response.json();",
                  "pm.test('Returns student role and linked student profile', function () {",
                  "    pm.expect(data.user.role).to.eql('student');",
                  "    pm.expect(data.user.rollNumber).to.eql('CS2024001');",
                  "    pm.expect(data.user).to.have.property('studentProfile');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "1.4 Register New Student (201 Created)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sameer Khan\",\n  \"email\": \"sameer.khan@edusphere.edu\",\n  \"password\": \"password123\",\n  \"role\": \"student\",\n  \"rollNumber\": \"CS2024088\",\n  \"department\": \"Computer Science\",\n  \"year\": 3,\n  \"skills\": [\"React\", \"Node.js\", \"Docker\"],\n  \"bio\": \"Enthusiastic web and mobile engineer.\"\n}"
            },
            "url": "http://localhost:3000/api/auth/register"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var data = pm.response.json();",
                  "pm.test('Creates student account with token and studentId', function () {",
                  "    pm.expect(data).to.have.property('token');",
                  "    pm.expect(data.user.name).to.eql('Sameer Khan');",
                  "    pm.expect(data.user.role).to.eql('student');",
                  "    pm.expect(data.user).to.have.property('studentId');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
